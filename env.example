# העתיקו קובץ זה ל-.env ומלאו ערכים אמיתיים לפני עלייה לאוויר.

# פורט להרצת השרת (ברוב שירותי האחסון בענן מוגדר אוטומטית — אין צורך לגעת)
PORT=3000

# מפתח סודי לחתימת עוגיות ההתחברות (session). חובה למלא ערך אקראי וקבוע בסביבת ייצור,
# אחרת כל הפעלה מחדש של השרת תנתק את כל המשתמשים המחוברים.
# ליצירת ערך אקראי: הריצו בטרמינל   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
